    {
      "name": "Sources",
      "item": [
        {
          "name": "01 Ingest Sample Sources",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Source ingest returns at least one source', function () { pm.expect(data.items).to.be.an('array').and.not.empty; });",
                  "if (data.items && data.items.length) { pm.collectionVariables.set('source_id', data.items[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-API-Key",
                "value": "{{internal_api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"title\": \"Government fact-check bulletin on viral internet shutdown claim\",\n      \"url\": \"https://example.com/fact-check/internet-shutdown\",\n      \"publisher\": \"JachAI Sample Source\",\n      \"language\": \"English\",\n      \"source_type\": \"fact_check\",\n      \"snippet\": \"A sample fact-check source used for Postman verification flow tests.\",\n      \"text_content\": \"This sample source says there is no official nationwide internet shutdown announcement for tonight. Users should rely on official telecom notices and government statements instead of forwarded rumors.\",\n      \"metadata\": {\n        \"seeded_by\": \"postman\",\n        \"category\": \"fact_check\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/sources/ingest",
            "description": "Protected endpoint. Seeds at least one evidence source so the claim pipeline has something to retrieve. Matching material file: `postman/test-materials/source_ingest_payload.json`."
          }
        },
        {
          "name": "02 List Sources",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('List sources returns an array', function () { pm.expect(data.items).to.be.an('array'); });",
                  "if (data.items && data.items.length) { pm.collectionVariables.set('source_id', data.items[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/sources"
          }
        },
        {
          "name": "03 Get Source By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Source ID matches variable', function () { pm.expect(data.id).to.eql(pm.collectionVariables.get('source_id')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/sources/{{source_id}}",
            "description": "Requires `source_id` from the source ingest or source list request."
          }
        }
      ]
    },
    {
      "name": "Claims",
      "item": [
        {
          "name": "01 Submit Text Claim",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Text claim returns job and claim', function () { pm.expect(data.job.id).to.be.a('string'); pm.expect(data.claim.id).to.be.a('string'); });",
                  "pm.collectionVariables.set('job_id', data.job.id);",
                  "pm.collectionVariables.set('claim_id', data.claim.id);",
                  "if (data.claim.cluster_id) { pm.collectionVariables.set('cluster_id', data.claim.cluster_id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"{{sample_claim_text}}\",\n  \"external_id\": \"{{external_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/claims/text",
            "description": "Matching material file: `postman/test-materials/claim_text_payload.json`."
          }
        },
        {
          "name": "02 Submit Image Claim",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or an expected image/OCR failure', function () { pm.expect([200, 422, 500]).to.include(pm.response.code); });",
                  "const data = pm.response.json();",
                  "if (pm.response.code === 200 && data.claim) { pm.collectionVariables.set('job_id', data.job.id); pm.collectionVariables.set('claim_id', data.claim.id); if (data.claim.cluster_id) { pm.collectionVariables.set('cluster_id', data.claim.cluster_id); } }",
                  "if (pm.response.code !== 200) { pm.test('Structured error is returned', function () { pm.expect(data.error).to.be.an('object'); }); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "/run/media/bakau/WORKPLACE/JachAI/backend/postman/test-materials/sample_claim_image.png",
                  "description": "Bundled OCR sample image. If Postman does not auto-attach it after import, browse to `{{sample_image_path}}` manually."
                },
                {
                  "key": "external_id",
                  "value": "{{external_id}}-image",
                  "type": "text"
                }
              ]
            },
            "url": "{{base_url}}/api/v1/claims/image",
            "description": "Uses the bundled OCR sample image at `postman/test-materials/sample_claim_image.png`. Reference OCR text: `postman/test-materials/sample_claim_image_expected_ocr.txt`. OCR depends on Tesseract being installed on the backend host."
          }
        },
        {
          "name": "03 Submit URL Claim",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 422', function () { pm.expect([200, 422]).to.include(pm.response.code); });",
                  "const data = pm.response.json();",
                  "if (pm.response.code === 200 && data.claim) { pm.collectionVariables.set('job_id', data.job.id); pm.collectionVariables.set('claim_id', data.claim.id); if (data.claim.cluster_id) { pm.collectionVariables.set('cluster_id', data.claim.cluster_id); } }",
                  "if (pm.response.code === 422) { pm.test('Structured error is returned', function () { pm.expect(data.error).to.be.an('object'); }); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{sample_claim_url}}\",\n  \"external_id\": \"{{external_id}}-url\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/claims/url",
            "description": "Matching material file: `postman/test-materials/claim_url_payload.json`. Depends on outbound HTTP access from the backend and enough text on the target page."
          }
        },
        {
          "name": "04 Get Verification Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Job ID matches variable', function () { pm.expect(data.id).to.eql(pm.collectionVariables.get('job_id')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/verification-jobs/{{job_id}}",
            "description": "Requires `job_id` from one of the claim or webhook submissions."
          }
        },
        {
          "name": "05 Get Claim By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Claim lookup returns the selected claim', function () { pm.expect(data.claim.id).to.eql(pm.collectionVariables.get('claim_id')); });",
                  "if (data.claim.cluster_id) { pm.collectionVariables.set('cluster_id', data.claim.cluster_id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/claims/{{claim_id}}",
            "description": "Requires `claim_id` from a successful claim or webhook submission."
          }
        },
        {
          "name": "06 Get Claim Share Summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Share summary belongs to the selected claim', function () { pm.expect(data.claim_id).to.eql(pm.collectionVariables.get('claim_id')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/claims/{{claim_id}}/share-summary"
          }
        },
        {
          "name": "07 Update Claim Review Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Review status is updated', function () { pm.expect(data.claim.review_status).to.eql('reviewed'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-API-Key",
                "value": "{{internal_api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"review_status\": \"reviewed\",\n  \"reviewer\": \"{{reviewer}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/claims/{{claim_id}}/review-status",
            "description": "Matching material file: `postman/test-materials/review_status_payload.json`."
          }
        },
        {
          "name": "08 List Claims",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Claim list returns an array', function () { pm.expect(data.items).to.be.an('array'); });",
                  "if (data.items && data.items.length) { pm.collectionVariables.set('claim_id', data.items[0].id); if (data.items[0].cluster_id) { pm.collectionVariables.set('cluster_id', data.items[0].cluster_id); } }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/claims?limit=10&offset=0"
          }
        }
      ]
    },
