APP_NAME=JachAI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
INTERNAL_API_KEY=change_this_key

DATABASE_URL=postgresql+asyncpg://user:password@your-neon-host.neon.tech/jachai?ssl=require
DATABASE_SYNC_URL=postgresql://user:password@your-neon-host.neon.tech/jachai?sslmode=require
REDIS_URL=redis://default:password@your-redis-host:6379/0

NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GOOGLE_FACT_CHECK_API_KEY=
GOOGLE_FACT_CHECK_ENABLED=true
NVIDIA_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_REASONING_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_CLAIM_EXTRACTION_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_QUERY_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_RERANK_MODEL=nvidia/rerank-qa-mistral-4b
NVIDIA_VISION_MODEL=moonshotai/kimi-k2.6
ENABLE_VISION_FALLBACK=true
NVIDIA_MAX_RPM=30
NVIDIA_MAX_UNCACHED_CLAIMS_PER_MINUTE=15
NVIDIA_TIMEOUT_SECONDS=60

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

PGVECTOR_TOP_K=20
FINAL_EVIDENCE_TOP_K=5
RERANK_MIN_CANDIDATES=6
MIN_RELEVANT_SIMILARITY=0.60

OCR_ENGINE=tesseract
OCR_LANGUAGES=ben+eng+hin
MAX_IMAGE_SIZE_MB=8
SEARCH_PROVIDER=google_fact_check
GENERAL_SEARCH_API_KEY=
GENERAL_SEARCH_BASE_URL=
GENERAL_SEARCH_MAX_RESULTS=8
LIVE_EVIDENCE_ENABLED=true
LIVE_EVIDENCE_TIMEOUT_SECONDS=12
LIVE_EVIDENCE_MAX_DOCUMENTS=10
LIVE_EVIDENCE_MAX_GOOGLE_RESULTS=6
LIVE_EVIDENCE_MAX_LISTING_LINKS_PER_CATALOG=8
LIVE_EVIDENCE_MAX_DOCUMENTS_PER_CATALOG=2
LIVE_EVIDENCE_MIN_ARTICLE_CHARACTERS=240

CLAIM_CACHE_TTL_SECONDS=172800
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
example