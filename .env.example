DATABASE_URL=postgresql+asyncpg://user:password@your-neon-host.neon.tech/jachai?ssl=require
DATABASE_SYNC_URL=postgresql://user:password@your-neon-host.neon.tech/jachai?sslmode=require
REDIS_URL=redis://default:password@your-redis-host:6379/0
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Legacy fallback if NVIDIA_REASONING_MODEL is omitted.
NVIDIA_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_REASONING_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_VISION_MODEL=
NVIDIA_ENABLE_VISION_FALLBACK=false
NVIDIA_MAX_RPM=30
NVIDIA_TIMEOUT_SECONDS=60
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
INTERNAL_API_KEY=replace-this-with-a-long-random-string
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
