APP_NAME=JachAI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
INTERNAL_API_KEY=change_this_key
VERIFICATION_PIPELINE_VERSION=evidence-pipeline-v11

DATABASE_URL=postgresql+asyncpg://user:password@your-neon-host.neon.tech/jachai?ssl=require
DATABASE_SYNC_URL=postgresql://user:password@your-neon-host.neon.tech/jachai?sslmode=require
REDIS_URL=redis://default:password@your-redis-host:6379/0

# Claim extraction via Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CLAIM_EXTRACTION_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60

NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_REASONING_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_CLAIM_EXTRACTION_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_QUERY_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_RERANK_MODEL=nv-rerank-qa-mistral-4b:1
NVIDIA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/reranking
# OCR via Kimi 2.6
NVIDIA_VISION_MODEL=moonshotai/kimi-k2.6
ENABLE_VISION_FALLBACK=true
NVIDIA_MAX_RPM=30
NVIDIA_MAX_UNCACHED_CLAIMS_PER_MINUTE=15
NVIDIA_TIMEOUT_SECONDS=60

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

PGVECTOR_TOP_K=20
FINAL_EVIDENCE_TOP_K=10
RERANK_MIN_CANDIDATES=6
MIN_RELEVANT_SIMILARITY=0.60

MAX_IMAGE_SIZE_MB=8

# Search / Tavily
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-your-key
GENERAL_SEARCH_API_KEY=tvly-your-key
GENERAL_SEARCH_BASE_URL=
GENERAL_SEARCH_MAX_RESULTS=10
TAVILY_SEARCH_DEPTH=basic
TAVILY_TOPIC=news
TAVILY_INCLUDE_ANSWER=false
TAVILY_INCLUDE_RAW_CONTENT=false
TAVILY_INCLUDE_IMAGES=false
TAVILY_MAX_RESULTS=10

# Live evidence (Tavily crawl pipeline)
LIVE_EVIDENCE_ENABLED=true
LIVE_EVIDENCE_TIMEOUT_SECONDS=12
LIVE_EVIDENCE_MAX_DOCUMENTS=10
LIVE_EVIDENCE_MAX_LISTING_LINKS_PER_CATALOG=8
LIVE_EVIDENCE_MAX_DOCUMENTS_PER_CATALOG=2
LIVE_EVIDENCE_MIN_ARTICLE_CHARACTERS=240

# Evidence pipeline (new v11 settings)
MAX_SOURCES_TO_FETCH=10
MAX_EVIDENCE_CHUNKS=20
ENABLE_DEBUG_OUTPUT=false
FETCH_TIMEOUT_SECONDS=10
MAX_FETCH_BYTES=2000000
LLM_JSON_RETRY_COUNT=1

# Trusted domains for source credibility scoring (comma-separated, no spaces)
# Leave empty to use the built-in default registry
TRUSTED_DOMAINS=nasa.gov,who.int,cdc.gov,un.org,reuters.com,apnews.com,bbc.com,factcheck.org,snopes.com

# Caching
CLAIM_CACHE_TTL_SECONDS=172800

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
